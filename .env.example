# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=echoes_dungeon
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ============================================
# BCRYPT CONFIGURATION
# ============================================
BCRYPT_ROUNDS=10

# ============================================
# GAME SETTINGS
# ============================================
# Tick interval in milliseconds (2 hours = 7200000)
TICK_INTERVAL_MS=7200000

# Maximum party size
MAX_PARTY_SIZE=10

# Maximum inventory slots per player
MAX_INVENTORY_SLOTS=50

# Starting gold for new players
STARTING_GOLD=100

# Starting level for new players
STARTING_LEVEL=1

# ============================================
# ADMIN SETTINGS
# ============================================
# First admin user credentials (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ============================================
# CORS SETTINGS
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ============================================
# SESSION (if using express-session)
# ============================================
SESSION_SECRET=your_session_secret_change_this

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# COMBAT ENGINE SETTINGS
# ============================================
# Maximum combat rounds before automatic draw
MAX_COMBAT_ROUNDS=50

# Critical hit threshold bonus (added to defense roll)
CRITICAL_HIT_THRESHOLD=15

# Critical hit damage multiplier
CRITICAL_DAMAGE_MULTIPLIER=2.0

# ============================================
# LOOT SETTINGS
# ============================================
# Base drop rates (percentages)
LOOT_COMMON_RATE=75
LOOT_UNCOMMON_RATE=15
LOOT_RARE_RATE=8
LOOT_EPIC_RATE=2
LOOT_LEGENDARY_RATE=0

# Gold multiplier for loot
GOLD_LOOT_MULTIPLIER=1.0

# ============================================
# DEVELOPMENT / DEBUG
# ============================================
# Enable debug mode (more verbose logging)
DEBUG=false

# Enable SQL query logging
LOG_SQL_QUERIES=false

# Enable combat simulation logging
LOG_COMBAT_DETAILS=true

# Skip tick schedule (for testing, runs ticks on demand)
SKIP_TICK_SCHEDULE=false

# ============================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================
# Redis (for caching, if implemented later)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Email service (for password reset, notifications, etc.)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@echodungeon.com
# EMAIL_PASSWORD=
# EMAIL_FROM=Echoes of the Dungeon <noreply@echodungeon.com>

# Sentry (error tracking, if implemented)
# SENTRY_DSN=

# ============================================
# PRODUCTION DEPLOYMENT
# ============================================
# Database URL (alternative to individual DB_ vars)
# DATABASE_URL=mysql://user:password@host:port/database

# SSL/TLS
# USE_SSL=true
# SSL_KEY_PATH=
# SSL_CERT_PATH=

# Trusted proxy (if behind nginx/apache)
# TRUST_PROXY=true

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env to version control
# 3. Change all secrets/passwords in production
# 4. TICK_INTERVAL_MS: 7200000 = 2 hours (production), 60000 = 1 minute (testing)
# 5. For production, use strong random strings for JWT_SECRET and SESSION_SECRET